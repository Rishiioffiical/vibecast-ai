rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 0: Global Safety Net — Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role-based Access Control: Strictly requires email_verified == true to prevent email spoofing
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['dubeyrishi135@gmail.com', 'rdpandit913@gmail.com'];
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for User Profiles (Strict keys, types, and size bounds)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'credits'])
        && data.keys().hasOnly([
          'id',
          'email',
          'displayName',
          'credits',
          'totalGeneratedChars',
          'totalTakes',
          'isPremium',
          'createdAt',
          'lastLoginAt',
          'lastResetDate',
          'lastBonusClaimDate'
        ])
        && data.id == request.auth.uid
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && data.credits is number && data.credits >= 0 && data.credits <= 10000000
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('isPremium' in data) || (data.isPremium is bool))
        && (!('totalGeneratedChars' in data) || (data.totalGeneratedChars is number && data.totalGeneratedChars >= 0))
        && (!('totalTakes' in data) || (data.totalTakes is number && data.totalTakes >= 0))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64))
        && (!('lastResetDate' in data) || (data.lastResetDate is string && data.lastResetDate.size() <= 32))
        && (!('lastBonusClaimDate' in data) || (data.lastBonusClaimDate is string && data.lastBonusClaimDate.size() <= 32));
    }

    // Validation Blueprint for Voice Takes (Strict keys, types, and size bounds)
    function isValidVoiceTake(data, targetUserId) {
      return data.keys().hasAll(['id', 'userId', 'text', 'voiceName', 'createdAt'])
        && data.keys().hasOnly([
          'id',
          'userId',
          'title',
          'text',
          'audioUrl',
          'voiceName',
          'language',
          'emotionLabel',
          'speed',
          'duration',
          'charCount',
          'creditsUsed',
          'createdAt'
        ])
        && data.userId == request.auth.uid
        && data.userId == targetUserId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.text is string && data.text.size() > 0 && data.text.size() <= 10000
        && data.voiceName is string && data.voiceName.size() > 0 && data.voiceName.size() <= 128
        && data.createdAt is number && data.createdAt > 0
        && (!('title' in data) || (data.title is string && data.title.size() <= 256))
        && (!('audioUrl' in data) || (data.audioUrl is string && data.audioUrl.size() <= 2048))
        && (!('language' in data) || (data.language is string && data.language.size() <= 32))
        && (!('emotionLabel' in data) || (data.emotionLabel is string && data.emotionLabel.size() <= 128))
        && (!('speed' in data) || (data.speed is number && data.speed >= 0.25 && data.speed <= 4.0))
        && (!('duration' in data) || (data.duration is number && data.duration >= 0 && data.duration <= 7200))
        && (!('charCount' in data) || (data.charCount is number && data.charCount >= 0 && data.charCount <= 10000))
        && (!('creditsUsed' in data) || (data.creditsUsed is number && data.creditsUsed >= 0 && data.creditsUsed <= 10000));
    }

    // Connection testing endpoint for boot check (single document get only)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // User Accounts & Quota Protection (PII Isolated to Owner or Verified Admin)
    match /users/{userId} {
      allow get: if (isOwner(userId) && isValidId(userId)) || isAdmin();
      allow list: if isAdmin();

      // Create: Normal creators cannot self-assign premium status or credits higher than 2,000 limit
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && (isAdmin() || (incoming().isPremium == false && incoming().credits <= 2000));

      // Action-Based Update with strict affectedKeys().hasOnly() and immutable identity fields
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == existing().id
        && incoming().email == existing().email
        && (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'credits',
          'totalGeneratedChars',
          'totalTakes',
          'isPremium',
          'lastLoginAt',
          'lastResetDate',
          'lastBonusClaimDate'
        ])
        && (
          isAdmin()
          || (
            incoming().isPremium == existing().isPremium
            && (
              // Action 1: Standard credit deduction or profile activity sync
              incoming().credits <= existing().credits
              // Action 2: Daily Reset at 12:00 AM / new calendar date (resets back to max 2,000 allowance)
              || (
                incoming().credits <= 2000
                && (!('lastResetDate' in existing()) || incoming().lastResetDate != existing().lastResetDate)
              )
            )
          )
        );

      allow delete: if (isOwner(userId) && isValidId(userId)) || isAdmin();

      // Audio Takes Subcollection (Protected by Master Gate parent check & Query Enforcer)
      match /takes/{takeId} {
        allow get: if (isOwner(userId) && isValidId(userId) && isValidId(takeId)) || isAdmin();
        allow list: if (isOwner(userId) && existing().userId == request.auth.uid) || isAdmin();

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(takeId)
          && isValidVoiceTake(incoming(), userId)
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(takeId)
          && isValidVoiceTake(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'text',
            'audioUrl',
            'voiceName',
            'language',
            'emotionLabel',
            'speed',
            'duration',
            'charCount',
            'creditsUsed'
          ])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if (isOwner(userId) && isValidId(userId) && isValidId(takeId)) || isAdmin();
      }
    }
  }
}
