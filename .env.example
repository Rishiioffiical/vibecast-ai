# GEMINI_API_KEY: Default Gemini API key automatically injected in AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_API_KEY: Dedicated Gemini API key used exclusively for the admin user (rdpandit913@gmail.com)
ADMIN_API_KEY="MY_ADMIN_API_KEY"

# PUBLIC_API_KEY: Separate Gemini API key used for public/free users to protect admin personal quota
PUBLIC_API_KEY="MY_PUBLIC_API_KEY"

# ADMIN_EMAIL: Admin email to route requests to ADMIN_API_KEY
ADMIN_EMAIL="rdpandit913@gmail.com"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
